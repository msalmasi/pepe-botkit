{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/events/typing.schema.json",
  "title": "event typing: data",
  "description": "(1.1) A user is typing (low priority; may be dropped). Needs features.typing.",
  "type": "object",
  "required": [
    "user"
  ],
  "properties": {
    "user": {
      "$ref": "../defs.schema.json#/$defs/UserRef"
    },
    "on": {
      "type": "boolean",
      "description": "false = stopped typing. Absent = true."
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
