{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pepe-botkit.invalid/pcp/v1/results/user.list.schema.json",
  "title": "result user.list: data",
  "description": "user.list result.",
  "type": "object",
  "required": [
    "members",
    "complete"
  ],
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/Member"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean",
      "description": "False when some rows could not be read (e.g. Camfrog owner-drawn list rows that never painted)."
    },
    "method": {
      "type": "string",
      "maxLength": 64
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
