{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/results/audio.play.schema.json",
  "title": "result audio.play: data",
  "description": "audio.play result (interim results use the same shape with final=false).",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "accepted",
        "queued",
        "playing",
        "played",
        "dropped"
      ]
    },
    "waited_ms": {
      "$ref": "../defs.schema.json#/$defs/DurationMs"
    },
    "played_ms": {
      "$ref": "../defs.schema.json#/$defs/DurationMs"
    },
    "dropped_reason": {
      "enum": [
        "mic_full",
        "blocked",
        "synthesis_failed",
        "cancelled",
        "other"
      ]
    },
    "phase": {
      "$ref": "../defs.schema.json#/$defs/Phase",
      "description": "(1.1) Finer progress beside status: queued, waiting (for a free mic slot), playing, played, dropped. Open."
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
