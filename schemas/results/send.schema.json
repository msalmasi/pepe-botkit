{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pepe-botkit.invalid/pcp/v1/results/send.schema.json",
  "title": "result send: data",
  "description": "send / send.private result.",
  "type": "object",
  "required": [
    "parts"
  ],
  "properties": {
    "message_ids": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/Id"
      }
    },
    "parts": {
      "type": "integer",
      "minimum": 0,
      "description": "Platform messages actually posted (after splitting)."
    },
    "truncated": {
      "type": "boolean"
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
