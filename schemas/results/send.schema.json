{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/results/send.schema.json",
  "title": "result send: data",
  "description": "send / send.private result.",
  "type": "object",
  "required": [
    "parts"
  ],
  "properties": {
    "message_ids": {
      "type": "array",
      "items": {
        "$ref": "../defs.schema.json#/$defs/Id"
      }
    },
    "parts": {
      "type": "integer",
      "minimum": 0,
      "description": "Platform messages actually posted (after splitting)."
    },
    "truncated": {
      "type": "boolean"
    },
    "t": {
      "description": "(1.1) Timing: wait_ms in the connector's queue, send_ms on the platform call.",
      "type": "object",
      "properties": {
        "wait_ms": {
          "$ref": "../defs.schema.json#/$defs/DurationMs"
        },
        "send_ms": {
          "$ref": "../defs.schema.json#/$defs/DurationMs"
        }
      }
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
