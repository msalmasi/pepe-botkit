{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pepe-botkit.invalid/pcp/v1/actions/react.schema.json",
  "title": "action react: data",
  "description": "Add or remove a reaction (needs features.reactions).",
  "type": "object",
  "required": [
    "message_id",
    "emoji",
    "op"
  ],
  "properties": {
    "message_id": {
      "$ref": "../defs.schema.json#/$defs/Id"
    },
    "emoji": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "id": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "op": {
      "enum": [
        "add",
        "remove"
      ]
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
