{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/actions/interaction.respond.schema.json",
  "title": "action interaction.respond: data",
  "description": "(1.1) Answer an interaction (the first answer, or the one after a defer).",
  "type": "object",
  "required": [
    "interaction_id"
  ],
  "properties": {
    "interaction_id": {
      "$ref": "../defs.schema.json#/$defs/Id"
    },
    "text": {
      "$ref": "../defs.schema.json#/$defs/Text"
    },
    "content": {
      "$ref": "../defs.schema.json#/$defs/Content"
    },
    "ephemeral": {
      "type": "boolean"
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  },
  "anyOf": [
    {
      "required": [
        "text"
      ]
    },
    {
      "required": [
        "content"
      ]
    }
  ]
}
