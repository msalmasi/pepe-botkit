{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/actions/cam.capture.schema.json",
  "title": "action cam.capture: data",
  "description": "Grab one frame of a user's camera as an image. open_if_closed lets the connector open the cam first; wait_ready_ms waits past loading frames.",
  "type": "object",
  "required": [
    "user"
  ],
  "properties": {
    "user": {
      "$ref": "../defs.schema.json#/$defs/UserRef"
    },
    "open_if_closed": {
      "type": "boolean"
    },
    "wait_ready_ms": {
      "$ref": "../defs.schema.json#/$defs/DurationMs"
    },
    "max_width": {
      "type": "integer",
      "minimum": 16
    },
    "format": {
      "enum": [
        "jpeg",
        "png"
      ]
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
