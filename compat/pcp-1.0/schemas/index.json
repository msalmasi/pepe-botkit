    "mic.grab": "results/mic.grab.schema.json",
    "mic.release": "results/mic.release.schema.json",
    "audio.play": "results/audio.play.schema.json",
    "cam.capture": "results/cam.capture.schema.json",
    "cam.open": "results/cam.open.schema.json",
    "cam.self.set": "results/cam.self.set.schema.json",
