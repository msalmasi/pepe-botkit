    "room.list": {
      "schema": "actions/room.list.schema.json",
      "requires_room": false,
      "result": "room.list"
    },
    "mic.grab": {
      "schema": "actions/mic.grab.schema.json",
      "requires_room": true,
      "result": "mic.grab"
    },
    "mic.release": {
      "schema": "actions/mic.release.schema.json",
      "requires_room": true,
      "result": "mic.release"
    },
    "audio.play": {
      "schema": "actions/audio.play.schema.json",
      "requires_room": true,
      "result": "audio.play"
    },
    "cam.capture": {
      "schema": "actions/cam.capture.schema.json",
      "requires_room": true,
      "result": "cam.capture"
    },
    "cam.open": {
      "schema": "actions/cam.open.schema.json",
      "requires_room": true,
      "result": "cam.open"
    },
    "cam.close": {
      "schema": "actions/cam.close.schema.json",
      "requires_room": true,
