{
  "$comment": "Registry of every PCP type. scripts/gen-dispatch.mjs builds event/action/result.schema.json from it; validators load it.",
  "pcp": "1.0",
  "base": "https://github.com/msalmasi/pepe-botkit/pcp/v1/",
  "defs": "defs.schema.json",
  "envelope": "envelope.schema.json",
  "frame": "frame.schema.json",
  "error": "error.schema.json",
  "capabilities": "capabilities.schema.json",
  "control": {
    "hello": "control/hello.schema.json",
    "welcome": "control/welcome.schema.json",
    "ping": "control/ping.schema.json",
    "pong": "control/pong.schema.json",
    "ack": "control/ack.schema.json",
    "flow": "control/flow.schema.json",
    "bye": "control/bye.schema.json"
  },
