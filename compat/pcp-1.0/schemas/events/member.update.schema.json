{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/events/member.update.schema.json",
  "title": "event member.update: data",
  "description": "Something about a member changed: display name, roles, list group (Camfrog members vs lurkers), cam state.",
  "type": "object",
  "required": [
    "user",
    "changes"
  ],
  "properties": {
    "user": {
      "$ref": "../defs.schema.json#/$defs/UserRef"
    },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "display": {
          "type": "string",
          "maxLength": 512
        },
        "display_raw": {
          "type": "string",
          "maxLength": 2048
        },
        "group": {
          "$ref": "../defs.schema.json#/$defs/MemberGroup"
        },
        "on_cam": {
          "type": "boolean"
        },
        "idle": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
