{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msalmasi/pepe-botkit/pcp/v1/events/connector.status.schema.json",
  "title": "event connector.status: data",
  "description": "Connector health changed: the platform client/hook/API went down or came back.",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "enum": [
        "ready",
        "degraded",
        "platform_down",
        "recovering"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 1024
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "ok",
          "degraded",
          "down"
        ]
      }
    },
    "ext": {
      "$ref": "../defs.schema.json#/$defs/Ext"
    }
  }
}
